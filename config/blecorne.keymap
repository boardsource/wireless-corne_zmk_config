#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | ESC  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  ENT |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |   '  |
//                    | GUI | LWR | CTRL |  | SPC  | RSE  | ALT |
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp ESC   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp RET
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp SQT
                              &kp LGUI &mo 1 &kp LCTRL   &kp SPACE &mo 2 &kp RALT
            >;
        };
        lower_layer {
// -----------------------------------------------------------------------------------------
// |  ~ |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// |  ESC |  F1 |  F2 | F3  | F4  |  F5 |   | F6  |  _  |  +  |  {  |  }  |  "|"   |
// | SHFT |  F7 |  F8 | F9  | F10 | F11 |   | F12 |  -  |  =  |  [  |  ]  |  \   |
//                    |     |     |     |   |     |     |     |
            bindings = <
                &kp TILDE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp ESC   &kp F1   &kp F2 &kp F3   &kp F4   &kp F5      &kp F6    &kp UNDER &kp PLUS        &kp LBRC &kp RBRC &kp PIPE
                &kp LSHFT &kp F7   &kp F8 &kp F9   &kp F10  &kp F11     &kp F12   &kp MINUS &kp EQUAL       &kp LBKT &kp RBKT &kp BSLH
                              &trans &trans &trans   &trans &trans &trans
            >;
        };

        raise_layer {
// -----------------------------------------------------------------------------------------
// |   `  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  BKSP |
// | ESC | BT1 | BT2 | BT3 | BT_CLEAR |   | LFT | DWN |  UP | RGT |     |       |
// | SHFT | C_VOL_DN | C_MUTE | C_VOL_UP |  C_PP  |  C_NEXT |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
                &kp GRAVE &kp N1       &kp N2       &kp N3       &kp N4     &kp N5       &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &trans    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &trans      &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &kp C_PP   &kp C_NEXT  &trans   &trans   &trans &trans    &trans &trans
                              &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
